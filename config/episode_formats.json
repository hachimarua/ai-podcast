{
  "schema_version": 1,
  "config_version": "formats-v1",
  "timezone": "Asia/Tokyo",
  "default_format": "daily",
  "weekly_lab": {
    "enabled": false,
    "weekday": "sunday"
  },
  "formats": {
    "daily": {
      "display_name": "Daily Brief",
      "duration_label": "4〜6分",
      "prompt_character_min": 1000,
      "prompt_character_max": 1200,
      "hard_character_min": 800,
      "hard_character_max": 1600,
      "max_news_items": 2,
      "max_review_terms": 1,
      "speech_rate": "+10%",
      "audio_thresholds": {
        "min_duration_seconds": 240.0,
        "max_duration_seconds": 360.0,
        "min_mean_volume_db": -28.0,
        "max_mean_volume_db": -10.0,
        "max_peak_volume_db": -0.1,
        "max_long_silence_ratio": 0.15,
        "silence_noise_db": -45.0,
        "silence_min_seconds": 2.0
      }
    },
    "lab": {
      "display_name": "AI実装ラボ",
      "duration_label": "8〜12分",
      "prompt_character_min": 2000,
      "prompt_character_max": 2800,
      "hard_character_min": 1600,
      "hard_character_max": 3400,
      "max_news_items": 3,
      "max_review_terms": 1,
      "speech_rate": "+0%",
      "audio_thresholds": {
        "min_duration_seconds": 480.0,
        "max_duration_seconds": 720.0,
        "min_mean_volume_db": -28.0,
        "max_mean_volume_db": -10.0,
        "max_peak_volume_db": -0.1,
        "max_long_silence_ratio": 0.15,
        "silence_noise_db": -45.0,
        "silence_min_seconds": 2.0
      }
    }
  }
}
